# Supabase (required for /api/leads inserts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Internal OS
CRON_SECRET=
INTERNAL_ADMIN_EMAIL=igtechgh@gmail.com

# Resend — lead form emails
# Setup guide: docs/EMAIL-DELIVERABILITY.md
# Dashboard: https://resend.com/domains → verify buildwithinnocent.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_ADMIN_TO=igtechgh@gmail.com
# Until domain is verified in Resend + Namecheap DNS, keep sandbox on:
RESEND_USE_SANDBOX=true
# After domain verified (production):
# RESEND_USE_SANDBOX=false
# RESEND_FROM_CUSTOMER=Build With Innocent <hello@buildwithinnocent.com>
# RESEND_FROM_ADMIN=Innocent Golden <innocent@buildwithinnocent.com>
# RESEND_REPLY_TO=innocent@buildwithinnocent.com
# Optional custom open pixel (usually use Resend domain open tracking instead):
# RESEND_OPEN_TRACKING_PIXEL_URL=

# In-site AI chat (/api/chat) — see docs/CHAT-WEBHOOK.md
# Option A: same webhook as WhatsApp AI (+233 530 453 400)
# CHAT_WEBHOOK_URL=https://your-n8n-host/webhook/xxxxxxxx
# CHAT_WEBHOOK_SECRET=
# CHAT_WEBHOOK_FORMAT=meta
# CHAT_META_PHONE_NUMBER_ID=
# CHAT_META_BUSINESS_ACCOUNT_ID=
# CHAT_META_DISPLAY_NUMBER=233530453400
# Option B: OpenAI fallback (lib/chat-assistant.js prompt)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Cloudflare Turnstile (optional — enable together)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
