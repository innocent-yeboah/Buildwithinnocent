# Supabase (required for /api/leads inserts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Internal OS
CRON_SECRET=
INTERNAL_ADMIN_EMAIL=igtechgh@gmail.com

# Resend — lead form emails (admin + customer)
# Get key: https://resend.com/api-keys
# Verify domain: https://resend.com/domains → add buildwithinnocent.com DNS records
RESEND_API_KEY=re_xxxxxxxx
RESEND_ADMIN_TO=igtechgh@gmail.com
# Until domain is verified, set true to send from onboarding@resend.dev (testing only)
RESEND_USE_SANDBOX=false
# After domain verified (defaults below):
# RESEND_FROM_ADMIN=Build With Innocent <notifications@buildwithinnocent.com>
# RESEND_FROM_CUSTOMER=Build With Innocent <hello@buildwithinnocent.com>

# Cloudflare Turnstile (optional — enable together)
# If TURNSTILE_SECRET_KEY is set, the widget must load with NEXT_PUBLIC_TURNSTILE_SITE_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
